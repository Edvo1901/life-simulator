{
  "name": "life-simulator-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "node src/config/startNext.mts dev",
    "build": "next build",
    "start": "node src/config/startNext.mts start",
    "lint": "eslint .",
    "format": "prettier --ignore-path ../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../.prettierignore --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --passWithNoTests"
  },
  "dependencies": {
    "axios": "1.11.0",
    "i18next": "26.4.2",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "17.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/jest": "30.0.0",
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.1.1",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "prettier": "3.9.9",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3"
  }
}

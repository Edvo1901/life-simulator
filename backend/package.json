{
  "name": "life-simulator-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/@nestjs/cli/bin/nest.js start --watch",
    "build": "nest build",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/main.js",
    "lint": "eslint .",
    "format": "prettier --ignore-path ../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../.prettierignore --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "setup:admin": "pnpm build && node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/auth/bootstrap.js",
    "test:integration": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand auth.integration.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.0.4",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-express": "12.0.4",
    "@nestjs/typeorm": "12.0.1",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "mssql": "12.7.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.0.4",
    "@types/bcrypt": "6.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "25.0.3",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "prettier": "3.9.9",
    "ts-jest": "29.4.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
